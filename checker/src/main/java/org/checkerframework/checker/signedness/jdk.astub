package java.lang;

import org.checkerframework.checker.signedness.qual.BitPattern;

class Double {
    @BitPattern static long doubleToLongBits(double value);
    @BitPattern static long doubleToRawLongBits(double value);
    static double longBitsToDouble(@BitPattern long bits);
}

class Float {
    @BitPattern static int floatToIntBits(float value);
    @BitPattern static int floatToRawIntBits(float value);
    static float intBitsToFloat(@BitPattern int bits);
}
